# Port cấu hình cho server (mặc định: 3000)
PORT=3000

# OpenAI API Key (Dùng để sinh bài tập bằng AI phía server)
# Lưu ý: Không chia sẻ hoặc commit API key thật vào Git.
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (Tùy chọn: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini
