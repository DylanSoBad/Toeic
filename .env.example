# Local Node server; use HOST=0.0.0.0 only when intentionally exposing it to a network.
PORT=3000
HOST=127.0.0.1

# Server-side key only. Leave empty to keep live generation disabled.
# Copy this file to .env locally; never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Timeout includes receiving the response body (milliseconds, 1000-60000).
AI_TIMEOUT_MS=25000
